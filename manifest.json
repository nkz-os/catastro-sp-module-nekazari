{
  "id": "catastro-spain",
  "name": "Catastro Spain",
  "display_name": "Catastro Spain",
  "version": "1.0.0",
  "description": "Spanish cadastre integration for reverse geocoding and parcel lookup",
  "description_i18n": {
    "es": "Integración con el catastro español para geocodificación inversa y consulta de parcelas",
    "en": "Spanish cadastre integration for reverse geocoding and parcel lookup",
    "eu": "Espainiako katastroarekiko integrazioa geokodifikazio alderantzikaturako eta partzelen kontsultarako",
    "fr": "Intégration avec le cadastre espagnol pour le géocodage inverse et la consultation des parcelles",
    "pt": "Integração com o cadastro espanhol para geocodificação inversa e consulta de parcelas",
    "ca": "Integració amb el cadastre espanyol per a geocodificació inversa i consulta de parcel·les"
  },
  "short_description": "Spanish cadastre reverse geocoding and parcel lookup",
  "author": {
    "name": "Nekazari Team",
    "email": "nekazari@robotika.cloud",
    "organization": "Nekazari"
  },
  "category": "geospatial",
  "module_type": "ADDON_FREE",
  "required_plan_type": "basic",
  "pricing_tier": "FREE",
  "route_path": "/catastro",
  "label": "Catastro",
  "icon": "map",
  "accent": {
    "base": "#A855F7",
    "soft": "#F3E8FF",
    "strong": "#7E22CE"
  },
  "required_roles": ["Farmer", "TenantAdmin", "PlatformAdmin"],
  "dependencies": {
    "sdk_version": "^1.0.0",
    "react_version": "^18.3.1",
    "platform_version": "^2.0.0",
    "services": ["postgresql", "orion-ld"],
    "extensions": ["postgis"]
  },
  "permissions": {
    "api_access": ["/api/cadastral/*"],
    "storage_access": false,
    "external_requests": []
  },
  "build_config": {
    "type": "module-federation",
    "remote_entry_url": "/modules/catastro-spain/remoteEntry.js"
  },
  "slots": {
    "map-layer": ["CadastralMapClickHandler", "GeoSearchBar"],
    "layer-toggle": ["CadastralClickToggle"],
    "context-panel": [],
    "bottom-panel": [],
    "entity-tree": []
  },
  "surfaces": {
    "web": {
      "slots": {
        "map-layer": [
          {
            "id": "catastro-spain-click-handler",
            "moduleId": "catastro-spain",
            "component": "CadastralMapClickHandler",
            "priority": 100
          },
          {
            "id": "catastro-spain-geo-search",
            "moduleId": "catastro-spain",
            "component": "GeoSearchBar",
            "priority": 50
          },
          {
            "id": "catastro-spain-building-layer",
            "moduleId": "catastro-spain",
            "component": "CadastralBuildingLayer",
            "priority": 90
          }
        ],
        "layer-toggle": [
          {
            "id": "catastro-spain-click-toggle",
            "moduleId": "catastro-spain",
            "component": "CadastralClickToggle",
            "priority": 20
          },
          {
            "id": "catastro-spain-buildings-toggle",
            "moduleId": "catastro-spain",
            "component": "CadastralBuildingsToggle",
            "priority": 15
          }
        ],
        "context-panel": [],
        "bottom-panel": [],
        "entity-tree": []
      }
    }
  },
  "metadata": {
    "icon": "🗺️",
    "color": "#A855F7",
    "features": [
      "Spanish cadastre reverse geocoding",
      "Click-to-add parcel functionality",
      "Geocoding search bar with Nominatim",
      "Multi-region support (Spain, Navarra, Euskadi)"
    ],
    "screenshots": []
  },
  "config": {
    "regions": ["spain-state", "navarra", "euskadi"],
    "sync_to_postgres": true
  }
}
