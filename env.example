# =============================================================================
# MODULE_DISPLAY_NAME - Environment Configuration
# =============================================================================
# Copy this file to .env.local for local development
# =============================================================================

# =============================================================================
# Frontend Configuration
# =============================================================================

# Vite dev server port
VITE_PORT=5003

# API base URL (for local development, proxy to production)
VITE_API_URL=https://nkz.YOUR_DOMAIN

# =============================================================================
# Backend Configuration
# =============================================================================

# Application
APP_NAME=MODULE_DISPLAY_NAME
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/MODULE_NAME

# CORS (for local development)
CORS_ORIGINS=["http://localhost:5003","http://localhost:5173"]

# =============================================================================
# Keycloak / Authentication
# =============================================================================

KEYCLOAK_URL=https://auth.YOUR_DOMAIN/auth
KEYCLOAK_REALM=nekazari

# Platform NGSI-LD @context URL (required by the Orion client; no default)
CONTEXT_URL=https://nekazari.YOUR_DOMAIN/ngsi-ld-context.json
JWT_AUDIENCE=account

# Service-to-service authentication key (optional)
# MODULE_MANAGEMENT_KEY=your-secret-key

# =============================================================================
# Database (uncomment if using)
# =============================================================================

# PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@localhost:5432/database

# =============================================================================
# Redis (for caching WFS queries - uses platform's shared Redis)
# =============================================================================

# Redis connection URL (platform default)
REDIS_URL=redis://:@redis-service:6379/0

# For local development with Docker Compose:
# REDIS_URL=redis://:@localhost:6379/0

